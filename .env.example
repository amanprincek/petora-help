# Firebase web config — copy to `.env` and fill values from
# Firebase Console → Project Settings → Your apps → Web app.
# These keys are public identifiers (NOT secrets); security is enforced
# by Firestore/Storage rules, not by hiding these values.
# NEVER commit `.env` to git. See FIREBASE_SETUP.md for full steps.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
